# Use a separate Ranting Supabase project. Never use BookFlow credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin for auth email links (no trailing slash), e.g. http://localhost:3000 or https://app.example.com.
# Server-only; defaults to http://localhost:3000 in development.
SITE_URL=
# Optional: log Supabase request timings (endpoint path, status, ms; no query strings) from the server.
# SUPABASE_TRACE=1

# --- Development seed only (npm run seed:dev); see scripts/seed-dev.ts ---------------------------
# Server-only secret key, used by the seed script to create the test owner already confirmed.
# Never prefix it with NEXT_PUBLIC_, never commit it, and leave it unset in production hosting.
SUPABASE_SECRET_KEY=
# Test owner login for checking pages locally. Use a non-real address and a long random password.
DEV_SEED_OWNER_EMAIL=
DEV_SEED_OWNER_PASSWORD=
# Must equal the project ref in NEXT_PUBLIC_SUPABASE_URL ("local" for a local Supabase stack), or the seed refuses to run.
DEV_SEED_PROJECT_REF=
